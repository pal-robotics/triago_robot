<robot name="triago_torso">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="4.68E-03 -8.19E-03 143.52E-03"/>
      <mass value="14.56648"/>
      <inertia ixx="499.42373004E-03" ixy="1.75882948E-03" ixz="11.19298375E-03" iyy="526.82969543E-03" iyz="6.04744042E-03" izz="132.79782947E-03"/>
